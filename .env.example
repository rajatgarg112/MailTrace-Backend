# MailTrace-AI Backend Configuration
APP_NAME=MailTrace-AI
APP_ENV=development
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql://postgres:password@localhost:5432/mailtrace_db

# Optional discrete parameters (for reference / container orchestration)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mailtrace_db

# Security & Secrets
API_SECRET_KEY=replace_with_a_secure_secret_key_in_production
SECRET_KEY=replace_with_a_secure_secret_key_in_production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Pipeline Configuration
ANALYZER_TIMEOUT_SECONDS=10.0

# External Services (Placeholders)
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
